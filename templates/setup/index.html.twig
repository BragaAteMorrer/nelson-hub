{% extends 'base.html.twig' %}
{% block title %}Installation — Nelson Hub{% endblock %}
{% block body %}
<main class="shell" style="max-width:820px">
  <div class="card">
    <p class="muted">NELSON HUB</p>
    <h1>Installation initiale</h1>
    <p class="muted">Cette page ne fonctionne que tant qu'aucun utilisateur n'existe. Crée les trois comptes du foyer maintenant.</p>
  </div>

  {% for message in app.flashes('error') %}
    <div class="card" style="border-color:#991b1b">{{ message }}</div>
  {% endfor %}

  <form method="post" class="card">
    <input type="hidden" name="_token" value="{{ csrf_token('initial_setup') }}">
    {% for i in 1..3 %}
      <section class="card">
        <h2>Compte {{ i }}{% if i == 1 %} — administrateur{% endif %}</h2>
        <label>Nom</label>
        <input class="input" name="name_{{ i }}" required>
        <label>E-mail</label>
        <input class="input" type="email" name="email_{{ i }}" required>
        <label>Mot de passe</label>
        <input class="input" type="password" name="password_{{ i }}" minlength="10" required>
        <label>Confirmer</label>
        <input class="input" type="password" name="confirm_{{ i }}" minlength="10" required>
      </section>
    {% endfor %}
    <button class="btn" type="submit">Créer les 3 comptes</button>
  </form>
</main>
{% endblock %}
